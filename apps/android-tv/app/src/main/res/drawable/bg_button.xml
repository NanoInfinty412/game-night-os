<?xml version="1.0" encoding="utf-8"?>
<!-- Big remote-friendly button: focused state is a thick yellow border on pink. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/yellow" />
            <stroke android:width="5dp" android:color="@color/text" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/pink" />
            <stroke android:width="5dp" android:color="@color/yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/night_raised" />
            <stroke android:width="3dp" android:color="@color/night_line" />
        </shape>
    </item>
</selector>

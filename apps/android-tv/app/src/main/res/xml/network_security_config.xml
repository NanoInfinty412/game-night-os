<?xml version="1.0" encoding="utf-8"?>
<!--
  The game computer is reached by its LAN IP address over plain HTTP
  (e.g. http://192.168.1.218:5173/tv), so cleartext traffic must be allowed.
  Domain rules cannot express IP ranges, hence the base config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
